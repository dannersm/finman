# ==============================================
# FinMan Configuration
# ==============================================

# --- Bank Credentials (REQUIRED) ---
# Your credentials for the bank scraper
BANK_RUT=12345678-9
BANK_PASSWORD=your_password_here

# --- Database Configuration ---
# Default for Docker: mongodb://mongodb:27017
# Default for Local:  mongodb://localhost:27017
MONGODB_URI=mongodb://mongodb:27017
DB_NAME=FinMan

# --- Internal Services ---
# URL for the frontend to talk to the scraper service
# Default for Docker: http://scraper:3001
# Default for Local:  http://localhost:3001
SCRAPER_URL=http://scraper:3001